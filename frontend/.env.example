# Backend base URL. Leave empty for same-origin requests through the Vite proxy
# (recommended: the backend has no CORS middleware).
VITE_API_BASE_URL=

# Where the Vite dev/preview proxy forwards /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# DEVELOPMENT ONLY: simulated responses for the not-yet-implemented
# POST /api/v1/assistant/query. Always disabled in production builds.
VITE_USE_MOCK_API=false

# Show the clickable Hackathon Demo Accounts on the login page (local demo only).
VITE_SHOW_DEMO_ACCOUNTS=true

# Never put API keys, JWT secrets or database credentials in frontend env files:
# every VITE_* value is embedded in the public JavaScript bundle.
