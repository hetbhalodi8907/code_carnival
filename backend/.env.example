APP_NAME=Secure Multi-Modal RAG System
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=500
# Files awaiting CEO approval are kept here, apart from the active-document storage.
QUARANTINE_STORAGE_PATH=data/quarantine
MAX_PENDING_SUBMISSIONS_PER_USER=20
MAX_IMAGE_SIZE_MB=10
MAX_IMAGE_PIXELS=25000000
OCR_MIN_CONFIDENCE=0.5
CHUNK_SIZE=4000
CHUNK_OVERLAP=200
DOCUMENT_STORAGE_PATH=data/documents

# Local embeddings (no API key). The model downloads once to ~/.cache/huggingface.
# EMBEDDING_DIMENSION must equal the database vector column (384).
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=100
# Only for EMBEDDING_PROVIDER=openai (with a text-embedding-3 model at 384 dimensions).
OPENAI_API_KEY=

# Answer-generation LLM (Groq, OpenAI-compatible). Groq has no embeddings API.
GROQ_API_KEY=
# groq (default) or lm_studio. lm_studio makes the local model the ONLY provider: no Groq key is
# needed, nothing goes to a cloud API, and LM_STUDIO_MODEL below becomes required.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=45

# Optional local fallback through LM Studio (off by default). When enabled, Groq stays primary and
# LM Studio is tried once, only if Groq is rate limited (429), times out or is unavailable (503).
# LM_STUDIO_MODEL must be the exact "id" from GET <base url>/models of the running server.
# The URL must be on this machine (localhost, 127.0.0.1 or ::1).
LM_STUDIO_ENABLED=false
LM_STUDIO_BASE_URL=http://127.0.0.1:1235/v1
LM_STUDIO_MODEL=
# Only if the LM Studio server has authentication enabled; leave empty otherwise.
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT_SECONDS=120
LM_STUDIO_MAX_OUTPUT_TOKENS=2048

# Characters of authorized chunk text placed in one RAG context (whole chunks only).
RAG_MAX_CONTEXT_CHARACTERS=32000

# "Access denied" signal: a relevance probe over documents the user may NOT read. Denial needs a
# similarity of at least MIN_SIMILARITY that also beats the best authorized similarity by MARGIN.
# Calibrated for sentence-transformers/all-MiniLM-L6-v2; recalibrate if the embedding model changes.
ACCESS_DENIAL_MIN_SIMILARITY=0.40
ACCESS_DENIAL_MARGIN=0.10

# Required for login and protected endpoints. Use a random value of at least 32
# characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))".
# The app refuses to start in APP_ENV=production without it.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_system
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
