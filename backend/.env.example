APP_NAME=Secure Multi-Modal RAG System
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
MAX_PDF_SIZE_MB=25
CHUNK_SIZE=4000
CHUNK_OVERLAP=200
DOCUMENT_STORAGE_PATH=data/documents

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100
OPENAI_API_KEY=

# Answer-generation LLM (Groq, OpenAI-compatible). Groq has no embeddings API.
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# Required for login and protected endpoints. Use a random value of at least 32
# characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))".
# The app refuses to start in APP_ENV=production without it.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_system
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
